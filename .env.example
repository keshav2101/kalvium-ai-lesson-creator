# ── Required ──────────────────────────────────────────────────────────────────
# Google Gemini API key — get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Google Custom Search (for live web research) ───────────────────
# Without these, the app runs in DEMO MODE with clearly-labelled sample sources.
# Get a key at https://developers.google.com/custom-search/v1/overview
# Create a Programmable Search Engine at https://programmablesearchengine.google.com
GOOGLE_CSE_API_KEY=your_google_cse_key_here
GOOGLE_CSE_ID=your_programmable_search_engine_id_here

# ── App settings ──────────────────────────────────────────────────────────────
# Directory where lessons are persisted (relative to backend/)
LESSONS_DIR=data/lessons

